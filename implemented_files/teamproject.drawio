    <mxCell id="510" value="&lt;b&gt;📌 interest_history — Source of Truth: 이자 지급&lt;/b&gt;&lt;br&gt;1행 = 1회 이자 지급 이벤트. 지급 후 불변.&lt;br&gt;──────────────────────&lt;br&gt;&lt;b&gt;interest_reason (이자 발생 사유)&lt;/b&gt;&lt;br&gt;REGULAR_INTEREST: 정기 이자 (월별 지급)&lt;br&gt;MATURITY_INTEREST: 만기 이자 (만기 시 일괄 지급)&lt;br&gt;BONUS_INTEREST: 우대 금리 이자 (조건 충족 시 추가)&lt;br&gt;──────────────────────&lt;br&gt;&lt;b&gt;세제 처리 흐름&lt;/b&gt;&lt;br&gt;interest_before_tax: 세전 이자&lt;br&gt;interest_tax_amount: 이자소득세 (세전×14%)&lt;br&gt;local_income_tax_amount: 지방소득세 (이자소득세×10%)&lt;br&gt;interest_after_tax: 실제 지급액 (source of truth)&lt;br&gt;──────────────────────&lt;br&gt;&lt;b&gt;누적 이자 조회&lt;/b&gt;&lt;br&gt;SUM(interest_after_tax) WHERE contract_id = ?&lt;br&gt;total_interest_amount 컬럼 없음 — 계산으로 도출&lt;br&gt;──────────────────────&lt;br&gt;&lt;b&gt;applied_interest_rate (적용 금리)&lt;/b&gt;&lt;br&gt;지급 시점 확정 금리 스냅샷 (contracts.final_interest_rate와&lt;br&gt;동일하나 이자 건별 독립 보관 — 재계산 없이 검증 가능)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffcc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;arcSize=4;" vertex="1" parent="1">
      <mxGeometry x="1060" y="1546" width="420" height="404" as="geometry"/>
    </mxCell>
